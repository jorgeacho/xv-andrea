      text-decoration: none;
      font-size: 17px;
    }

    .boton:hover {
      background: #d4af37;
      color: #090909;
    }

    .contador {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin: 24px 0;
    }

    .contador div {
      padding: 14px 2px;
      background: #090909;
      border: 1px solid #80652d;
      border-radius: 8px;
    }

    .contador strong {
      display: block;
      color: #d4af37;
      font-size: 28px;
    }

