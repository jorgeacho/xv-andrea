<button id="boton-musica" onclick="controlarMusica()">
  🎵
</button>

<style>
  #boton-musica {
    position: fixed;
    bottom: 12px;
    right: 12px;
    z-index: 1000;
    background: linear-gradient(135deg, #d4af37, #f8e7a0);
    color: #17120a;
    border: 2px solid #fff0b3;
    border-radius: 40px;
    padding: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 18px #0008;
  }

  #boton-musica:hover {
    transform: scale(1.05);
  }
</style>

<script>
  const musica = document.getElementById("musica");
  const botonMusica = document.getElementById("boton-musica");

  async function controlarMusica() {
    if (musica.paused) {
      try {
        await musica.play();
        botonMusica.textContent = "⏸";
      } catch (error) {
        alert("No se pudo reproducir la música.");
      }
    } else {
      musica.pause();
      botonMusica.textContent = "🎵";
    }
  }
</script>


<!-- CONFIRMACIÓN -->
