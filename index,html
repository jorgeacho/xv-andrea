<!-- ANIMACIÓN DE ENTRADA AIZE DIGITAL -->
<style>
  section.entrada-aize {
    opacity: 0;
    transform: translateY(60px);
    animation: none !important;
    transition: opacity 1.2s ease,
                transform 1.2s ease;
  }

  section.entrada-aize.visible-aize {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    section.entrada-aize {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const cuadros = document.querySelectorAll("section");

    if (!("IntersectionObserver" in window)) {
      return;
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            entrada.target.classList.add("visible-aize");
            observador.unobserve(entrada.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    cuadros.forEach((cuadro) => {
      cuadro.classList.add("entrada-aize");
      observador.observe(cuadro);
    });
  });
</script>

<!-- DESTELLOS DORADOS AIZE DIGITAL -->
<style>
  #destellos-aize {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .particula-aize {
    position: absolute;
    bottom: -15px;
    width: 4px;
    height: 4px;
    background: #ffd700;
    border-radius: 50%;
    box-shadow:
      0 0 8px #ffd700,
      0 0 15px #d4af37;
    animation: flotarAize linear infinite;
  }

  @keyframes flotarAize {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    20% {
      opacity: 0.8;
    }
    80% {
      opacity: 0.8;
    }
    100% {
      transform: translateY(-110vh);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particula-aize {
      animation: none;
      display: none;
    }
  }
</style>

<div id="destellos-aize" aria-hidden="true"></div>

<script>
  const fondoDestellos =
    document.getElementById("destellos-aize");

  for (let i = 0; i < 25; i++) {
    const particula = document.createElement("span");

    particula.className = "particula-aize";

    particula.style.left =
      Math.random() * 100 + "%";

    particula.style.animationDuration =
      (8 + Math.random() * 10) + "s";

    particula.style.animationDelay =
      (-Math.random() * 18) + "s";

    fondoDestellos.appendChild(particula);
  }
</script>

